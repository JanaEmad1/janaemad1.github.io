---
import Icon from './Icon.astro';
import { ui, path, type Lang } from '../i18n/ui';
import { site, contactUrl } from '../site.config';

interface Props { lang: Lang; alternate: string }
const { lang, alternate } = Astro.props;
const t = ui[lang];
const home = path(lang, '/');
---
<a class="skip" href="#main">{t.skip}</a>
<header class="header">
  <div class="container bar">
    <a class="brand" href={home}>{site.brand[lang]}<span class="accent">.</span></a>
    <nav aria-label={lang === 'ar' ? 'الرئيسية' : 'Main'}>
      <ul>
        <li><a href={`${home}#services`}>{t.nav.services}</a></li>
        <li><a href={`${home}#work`}>{t.nav.work}</a></li>
        <li><a href={`${home}#packages`}>{t.nav.packages}</a></li>
        <li><a href={`${home}#faq`}>{t.nav.faq}</a></li>
      </ul>
    </nav>
    <div class="tools">
      <a class="chip" href={alternate} hreflang={lang === 'ar' ? 'en' : 'ar'} lang={lang === 'ar' ? 'en' : 'ar'}>
        <span aria-hidden="true">{t.otherLangCode}</span><span class="sr-only">{t.otherLang}</span>
      </a>
      <button class="chip theme" type="button" aria-label={t.themeToggle} data-theme-toggle>
        <Icon name="sun" class="i-sun" /><Icon name="moon" class="i-moon" />
      </button>
      <a class="btn btn-primary cta" href={contactUrl} rel="noopener" target="_blank">{t.cta}</a>
    </div>
  </div>
</header>

<script>
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const d = document.documentElement;
    const next = d.dataset.theme === 'light' ? 'dark' : 'light';
    d.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
</script>

<style>
  .header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 68px; }
  .brand { font-size: 1.35rem; font-weight: 800; text-decoration: none; }
  ul { display: flex; gap: 28px; list-style: none; margin: 0; padding: 0; }
  nav a { text-decoration: none; color: var(--muted); font-size: 0.92rem; transition: color 0.2s; }
  nav a:hover { color: var(--text); }
  .tools { display: flex; align-items: center; gap: 8px; }
  .chip {
    display: inline-grid; place-items: center; min-width: 40px; height: 40px; padding: 0 12px;
    border-radius: 99px; border: 1px solid var(--line); background: var(--card); color: var(--text);
    font: inherit; font-size: 0.85rem; text-decoration: none; cursor: pointer;
  }
  .chip :global(svg) { width: 18px; height: 18px; }
  .theme :global(.i-moon) { display: none; }
  :global([data-theme='light']) .theme :global(.i-moon) { display: block; }
  :global([data-theme='light']) .theme :global(.i-sun) { display: none; }
  .cta { padding: 10px 18px; font-size: 0.88rem; }
  @media (max-width: 860px) { nav { display: none; } }
  @media (max-width: 420px) { .cta { padding: 10px 14px; } .brand { font-size: 1.2rem; } }
</style>
